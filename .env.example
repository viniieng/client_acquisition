# The API reads this on startup (DotNetEnv loads .env automatically).
# Use the Npgsql key=value format below, NOT the postgresql:// URI from the Supabase UI.
# If the password contains special chars like $, wrap the WHOLE value in single quotes.
# Example: SUPABASE_CONNECTION_STRING='Host=...;Password=$$secret;SSL Mode=Require;Trust Server Certificate=true'
SUPABASE_CONNECTION_STRING=Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
API_BASE_URL=http://localhost:5000

@page "/orders"
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <h1 class="page-title">Pedidos</h1>
        <p class="page-subtitle">Acompanhe e gerencie os pedidos dos clientes.</p>
    </div>
    <div class="page-actions">
        <AppButton Variant="primary" Icon="plus" OnClick="OpenCreate">Novo Pedido</AppButton>
    </div>
</div>

<div class="toolbar">
    <div class="field search" style="min-width:240px">
        <Icon Name="search" />
        <input class="input" placeholder="Filtrar por nome do cliente" value="@_fName" @oninput="e => _fName = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="field">
        <label class="field-label">Data Inicial</label>
        <input class="input" type="date" value="@_fStart" @oninput="e => _fStart = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="field">
        <label class="field-label">Data Final</label>
        <input class="input" type="date" value="@_fEnd" @oninput="e => _fEnd = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="spacer"></div>
    @if (HasFilters)
    {
        <AppButton Variant="ghost" OnClick="ClearFilters">Limpar</AppButton>
    }
    <span class="muted">@Filtered.Count de @_orders.Count pedidos</span>
</div>

<AppTable Loading="_loading" Error="@_error"
          IsEmpty="!Filtered.Any()" EmptyIcon="cart"
          EmptyTitle="@(HasFilters ? "Nenhum pedido encontrado" : "Nenhum pedido ainda")"
          EmptyText="@(HasFilters ? "Ajuste os filtros para ver mais resultados." : "Crie seu primeiro pedido para começar.")">
    <Head>
        <th>Número do Pedido</th><th>Cliente</th><th>Data do Pedido</th><th class="text-right">Valor Total</th><th>Status</th><th class="text-right">Ações</th>
    </Head>
    <ChildContent>
        @foreach (var order in Filtered)
        {
            <tr>
                <td class="cell-strong cell-mono">@Format.ShortId(order.Id)</td>
                <td>
                    <div class="row-main">
                        <span class="row-avatar">@Format.Initials(order.CustomerFullName)</span>
                        <span>@order.CustomerFullName</span>
                    </div>
                </td>
                <td class="cell-muted">@Format.DateTimeShort(order.OrderDate)</td>
                <td class="text-right cell-strong cell-mono">@Format.Currency(order.TotalAmount)</td>
                <td>
                    @if (IsLocked(order))
                    {
                        <AppBadge Variant="neutral">Bloqueado</AppBadge>
                    }
                    else
                    {
                        <AppBadge Variant="success">Editável</AppBadge>
                    }
                </td>
                <td>
                    <div class="table-actions">
                        <button class="icon-btn" title="Ver detalhes" @onclick="() => View(order)"><Icon Name="eye" /></button>
                        <button class="icon-btn danger" title="Excluir" @onclick="() => OpenDelete(order)"><Icon Name="trash" /></button>
                    </div>
                </td>
            </tr>
        }
    </ChildContent>
</AppTable>

@* ----------------------------------------------------------- create order *@
<AppModal Visible="_createOpen" Large="true" Title="Criar pedido"
          Subtitle="Selecione um cliente e adicione os itens do pedido." OnClose="CloseCreate">
    <ChildContent>
        <div class="form-grid">
            <div class="field">
                <label class="field-label">Cliente <span class="req">*</span></label>
                <select class="input @(_itemError is not null && _form.CustomerId is null ? "invalid" : null)"
                        value="@(_form.CustomerId?.ToString() ?? string.Empty)" @onchange="OnCustomerChanged">
                    <option value="">Selecione um cliente…</option>
                    @foreach (var c in _customers)
                    {
                        <option value="@c.Id">@c.FullName</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label">Data do Pedido</label>
                <input class="input" type="date" value="@_orderDateText" @oninput="OnOrderDateChanged" />
            </div>
        </div>

        <div class="section-title" style="margin-top:18px">Itens</div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th style="width:42%">Produto</th><th>Quantidade</th><th>Preço Unitário</th><th class="text-right">Subtotal</th><th></th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _form.Items.Count; i++)
                    {
                        var index = i;
                        var item = _form.Items[index];
                        <tr>
                            <td>
                                <input class="input" placeholder="Nome do produto" @bind="item.ProductName" @bind:event="oninput" />
                            </td>
                            <td>
                                <input class="input" type="number" min="1" style="max-width:110px"
                                       @bind="item.Quantity" @bind:event="oninput" />
                            </td>
                            <td>
                                <input class="input" type="number" min="0" step="0.01" style="max-width:140px"
                                       @bind="item.UnitPrice" @bind:event="oninput" />
                            </td>
                            <td class="text-right cell-strong cell-mono">@Format.Currency(item.Subtotal)</td>
                            <td>
                                <button class="icon-btn danger" title="Remover item"
                                        disabled="@(_form.Items.Count == 1)" @onclick="() => RemoveItem(index)">
                                    <Icon Name="trash" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-top:12px">
            <AppButton Variant="secondary" Small="true" Icon="plus" OnClick="AddItem">Adicionar Item</AppButton>
        </div>

        @if (_itemError is not null)
        {
            <div class="field-error" style="margin-top:12px"><Icon Name="alert" Class="toast-icon" />@_itemError</div>
        }

        <div class="totals-row">
            <span class="label">Valor Total</span>
            <span class="value cell-mono">@Format.Currency(_form.Total)</span>
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="secondary" OnClick="CloseCreate" Disabled="_saving">Cancelar</AppButton>
        <AppButton Variant="primary" Icon="check" Loading="_saving" OnClick="Save">Criar pedido</AppButton>
    </Footer>
</AppModal>

<ConfirmDialog Visible="_deleting is not null"
               Title="Excluir pedido"
               ConfirmText="Excluir"
               Message="@($"Excluir o pedido {Format.ShortId(_deleting?.Id ?? Guid.Empty)}? Esta ação não pode ser desfeita.")"
               Busy="_deleteBusy"
               OnConfirm="ConfirmDelete"
               OnCancel="() => _deleting = null" />

@code {
    [SupplyParameterFromQuery(Name = "new")] public string? NewFlag { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<OrderResponseDto> _orders = new();
    private List<CustomerResponseDto> _customers = new();

    private string _fName = string.Empty;
    private string _fStart = string.Empty;
    private string _fEnd = string.Empty;

    private bool _createOpen;
    private bool _saving;
    private OrderForm _form = new();
    private string _orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string? _itemError;

    private OrderResponseDto? _deleting;
    private bool _deleteBusy;

    private bool HasFilters => !string.IsNullOrWhiteSpace(_fName) || !string.IsNullOrWhiteSpace(_fStart) || !string.IsNullOrWhiteSpace(_fEnd);

    private List<OrderResponseDto> Filtered
    {
        get
        {
            IEnumerable<OrderResponseDto> q = _orders;
            if (!string.IsNullOrWhiteSpace(_fName))
                q = q.Where(o => o.CustomerFullName.Contains(_fName, StringComparison.OrdinalIgnoreCase));
            if (DateOnly.TryParse(_fStart, out var start))
                q = q.Where(o => DateOnly.FromDateTime(o.OrderDate.ToLocalTime()) >= start);
            if (DateOnly.TryParse(_fEnd, out var end))
                q = q.Where(o => DateOnly.FromDateTime(o.OrderDate.ToLocalTime()) <= end);
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        if (!string.IsNullOrEmpty(NewFlag))
        {
            OpenCreate();
        }
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var ordersTask = Api.GetOrdersAsync();
            var customersTask = Api.GetCustomersAsync();
            await Task.WhenAll(ordersTask, customersTask);
            _orders = ordersTask.Result.OrderByDescending(o => o.OrderDate).ToList();
            _customers = customersTask.Result.OrderBy(c => c.FullName).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsLocked(OrderResponseDto order) => !OrderEditRules.IsEditable(order.CreatedAt);

    private void View(OrderResponseDto order) => Nav.NavigateTo($"orders/{order.Id}");
    private void ClearFilters() { _fName = _fStart = _fEnd = string.Empty; }

    private void OpenCreate()
    {
        _form = new OrderForm();
        _orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
        _itemError = null;
        _createOpen = true;
    }

    private void CloseCreate() => _createOpen = false;

    private void OnCustomerChanged(ChangeEventArgs e)
    {
        _form.CustomerId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private void OnOrderDateChanged(ChangeEventArgs e)
    {
        _orderDateText = e.Value?.ToString() ?? string.Empty;
        if (DateOnly.TryParse(_orderDateText, out var date))
        {
            _form.OrderDate = new DateTime(date.Year, date.Month, date.Day, 12, 0, 0, DateTimeKind.Utc);
        }
    }

    private void AddItem() => _form.Items.Add(new OrderItemForm());

    private void RemoveItem(int index)
    {
        if (_form.Items.Count > 1)
        {
            _form.Items.RemoveAt(index);
        }
    }

    private async Task Save()
    {
        _itemError = null;

        if (_form.CustomerId is null)
        {
            _itemError = "Selecione um cliente.";
            return;
        }

        if (_form.Items.Count == 0 || _form.Items.Any(i => string.IsNullOrWhiteSpace(i.ProductName) || i.Quantity < 1 || i.UnitPrice <= 0))
        {
            _itemError = "Cada item precisa de um nome de produto, quantidade ≥ 1 e preço unitário > 0.";
            return;
        }

        _saving = true;
        try
        {
            await Api.CreateOrderAsync(_form);
            Toasts.ShowSuccess("Pedido criado com sucesso.");
            _createOpen = false;
            await Load();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenDelete(OrderResponseDto order) => _deleting = order;

    private async Task ConfirmDelete()
    {
        if (_deleting is null) return;
        _deleteBusy = true;
        try
        {
            await Api.DeleteOrderAsync(_deleting.Id);
            Toasts.ShowSuccess("Pedido excluído.");
            _deleting = null;
            await Load();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _deleteBusy = false;
        }
    }
}

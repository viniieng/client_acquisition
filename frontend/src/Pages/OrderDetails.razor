@page "/orders/{Id:guid}"
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Nav

<a class="back-link" href="orders"><Icon Name="chevron-left" /> Voltar aos pedidos</a>

@if (_loading)
{
    <AppLoader Text="Carregando pedido…" />
}
else if (_error is not null || _order is null)
{
    <AppCard>
        <div class="state-error">
            <div class="empty-icon"><Icon Name="alert" /></div>
            <p class="empty-title">Pedido não encontrado</p>
            <p class="empty-text">@(_error ?? "Este pedido não existe ou foi removido.")</p>
            <AppButton Variant="secondary" OnClick="@(() => Nav.NavigateTo("orders"))">Voltar aos pedidos</AppButton>
        </div>
    </AppCard>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">Pedido @Format.ShortId(_order.Id)</h1>
            <p class="page-subtitle">Realizado em @Format.DateTimeShort(_order.OrderDate)</p>
        </div>
        <div class="page-actions">
            @if (_locked)
            {
                <AppBadge Variant="neutral">Bloqueado</AppBadge>
            }
            else
            {
                <AppBadge Variant="success">Editável</AppBadge>
            }
            <AppButton Variant="secondary" Icon="edit" Disabled="_locked" OnClick="OpenEdit">Editar</AppButton>
            <AppButton Variant="danger" Icon="trash" OnClick="() => _confirmDelete = true">Excluir</AppButton>
        </div>
    </div>

    @if (_locked)
    {
        <div class="warning-banner">
            <Icon Name="alert" />
            Este pedido só poderá ser editado 24 horas após a criação (@Format.DateTimeShort(_order.CreatedAt.AddHours(24))).
        </div>
    }

    <div class="stack">
        <AppCard Title="Cliente">
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">Nome</span><span class="detail-value">@_order.CustomerFullName</span></div>
                @if (_customer is not null)
                {
                    <div class="detail-item"><span class="detail-label">E-mail</span><span class="detail-value">@_customer.Email</span></div>
                    <div class="detail-item"><span class="detail-label">CPF</span><span class="detail-value">@Cpf.Mask(_customer.Cpf)</span></div>
                    <div class="detail-item"><span class="detail-label">Endereço</span><span class="detail-value">@_customer.Address</span></div>
                }
            </div>
        </AppCard>

        <AppCard Title="Resumo do pedido">
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">Data do pedido</span><span class="detail-value">@Format.DateTimeShort(_order.OrderDate)</span></div>
                <div class="detail-item"><span class="detail-label">Criado em</span><span class="detail-value">@Format.DateTimeShort(_order.CreatedAt)</span></div>
                <div class="detail-item"><span class="detail-label">Itens</span><span class="detail-value">@_order.Items.Count</span></div>
                <div class="detail-item"><span class="detail-label">Valor total</span><span class="detail-value">@Format.Currency(_order.TotalAmount)</span></div>
            </div>
        </AppCard>

        <AppCard Title="Itens" Flush="true">
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>Produto</th><th>Quantidade</th><th>Preço Unitário</th><th class="text-right">Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var item in _order.Items)
                        {
                            <tr>
                                <td class="cell-strong">@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td class="cell-mono">@Format.Currency(item.UnitPrice)</td>
                                <td class="text-right cell-strong cell-mono">@Format.Currency(item.Subtotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="totals-row" style="padding:16px">
                <span class="label">Valor Total</span>
                <span class="value cell-mono">@Format.Currency(_order.TotalAmount)</span>
            </div>
        </AppCard>
    </div>
}

@* ----------------------------------------------------------- edit modal *@
<AppModal Visible="_editOpen" Large="true" Title="Editar pedido"
          Subtitle="Atualize os itens e a data do pedido." OnClose="() => _editOpen = false">
    <ChildContent>
        <div class="form-grid">
            <div class="field">
                <label class="field-label">Cliente</label>
                <input class="input" value="@_order?.CustomerFullName" disabled />
            </div>
            <div class="field">
                <label class="field-label">Data do Pedido</label>
                <input class="input" type="date" value="@_editDateText" @oninput="OnEditDateChanged" />
            </div>
        </div>

        <div class="section-title" style="margin-top:18px">Itens</div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th style="width:42%">Produto</th><th>Quantidade</th><th>Preço Unitário</th><th class="text-right">Subtotal</th><th></th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _editForm.Items.Count; i++)
                    {
                        var index = i;
                        var item = _editForm.Items[index];
                        <tr>
                            <td><input class="input" placeholder="Nome do produto" @bind="item.ProductName" @bind:event="oninput" /></td>
                            <td><input class="input" type="number" min="1" style="max-width:110px" @bind="item.Quantity" @bind:event="oninput" /></td>
                            <td><input class="input" type="number" min="0" step="0.01" style="max-width:140px" @bind="item.UnitPrice" @bind:event="oninput" /></td>
                            <td class="text-right cell-strong cell-mono">@Format.Currency(item.Subtotal)</td>
                            <td>
                                <button class="icon-btn danger" title="Remover" disabled="@(_editForm.Items.Count == 1)" @onclick="() => _editForm.Items.RemoveAt(index)"><Icon Name="trash" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="margin-top:12px">
            <AppButton Variant="secondary" Small="true" Icon="plus" OnClick="() => _editForm.Items.Add(new OrderItemForm())">Adicionar Item</AppButton>
        </div>
        @if (_editError is not null)
        {
            <div class="field-error" style="margin-top:12px"><Icon Name="alert" Class="toast-icon" />@_editError</div>
        }
        <div class="totals-row">
            <span class="label">Valor Total</span>
            <span class="value cell-mono">@Format.Currency(_editForm.Total)</span>
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="secondary" OnClick="() => _editOpen = false" Disabled="_saving">Cancelar</AppButton>
        <AppButton Variant="primary" Icon="check" Loading="_saving" OnClick="SaveEdit">Salvar alterações</AppButton>
    </Footer>
</AppModal>

<ConfirmDialog Visible="_confirmDelete"
               Title="Excluir pedido"
               ConfirmText="Excluir"
               Message="Excluir este pedido? Esta ação não pode ser desfeita."
               Busy="_deleteBusy"
               OnConfirm="ConfirmDelete"
               OnCancel="() => _confirmDelete = false" />

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private OrderResponseDto? _order;
    private CustomerResponseDto? _customer;
    private bool _locked;

    private bool _editOpen;
    private bool _saving;
    private string? _editError;
    private OrderForm _editForm = new();
    private string _editDateText = string.Empty;

    private bool _confirmDelete;
    private bool _deleteBusy;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            _order = await Api.GetOrderAsync(Id);
            if (_order is not null)
            {
                _locked = !OrderEditRules.IsEditable(_order.CreatedAt);
                _customer = await Api.GetCustomerAsync(_order.CustomerId);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEdit()
    {
        if (_order is null) return;
        if (_locked)
        {
            Toasts.ShowError(OrderEditRules.LockMessage);
            return;
        }
        _editForm = new OrderForm
        {
            CustomerId = _order.CustomerId,
            OrderDate = _order.OrderDate,
            Items = _order.Items.Select(i => new OrderItemForm
            {
                ProductName = i.ProductName,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList()
        };
        _editDateText = _order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd");
        _editError = null;
        _editOpen = true;
    }

    private void OnEditDateChanged(ChangeEventArgs e)
    {
        _editDateText = e.Value?.ToString() ?? string.Empty;
        if (DateOnly.TryParse(_editDateText, out var date))
        {
            _editForm.OrderDate = new DateTime(date.Year, date.Month, date.Day, 12, 0, 0, DateTimeKind.Utc);
        }
    }

    private async Task SaveEdit()
    {
        _editError = null;
        if (_locked)
        {
            _editError = OrderEditRules.LockMessage;
            return;
        }

        if (_editForm.Items.Count == 0 || _editForm.Items.Any(i => string.IsNullOrWhiteSpace(i.ProductName) || i.Quantity < 1 || i.UnitPrice <= 0))
        {
            _editError = "Cada item precisa de um nome de produto, quantidade ≥ 1 e preço unitário > 0.";
            return;
        }

        _saving = true;
        try
        {
            await Api.UpdateOrderAsync(Id, _editForm);
            Toasts.ShowSuccess("Pedido atualizado com sucesso.");
            _editOpen = false;
            await Load();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        _deleteBusy = true;
        try
        {
            await Api.DeleteOrderAsync(Id);
            Toasts.ShowSuccess("Pedido excluído.");
            Nav.NavigateTo("orders");
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
            _deleteBusy = false;
            _confirmDelete = false;
        }
    }
}

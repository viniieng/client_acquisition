@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar @(_open ? "open" : null)">
        <div class="sidebar-brand">
            <span class="brand-mark">CA</span>
            <div class="brand-text">
                <strong>Client Acquisition</strong>
                <span>Plataforma CRM</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <span class="nav-section-label">Menu</span>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <Icon Name="dashboard" Class="nav-icon" /> Painel
            </NavLink>
            <NavLink class="nav-item" href="customers" @onclick="CloseMenu">
                <Icon Name="users" Class="nav-icon" /> Clientes
            </NavLink>
            <NavLink class="nav-item" href="orders" @onclick="CloseMenu">
                <Icon Name="cart" Class="nav-icon" /> Pedidos
            </NavLink>
            <NavLink class="nav-item" href="reports" @onclick="CloseMenu">
                <Icon Name="reports" Class="nav-icon" /> Relatórios
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            v1.0 · @DateTime.Now.Year
        </div>
    </aside>

    <div class="backdrop @(_open ? "show" : null)" @onclick="CloseMenu"></div>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Alternar menu">
                    <Icon Name="menu" Class="nav-icon" />
                </button>
                <span class="topbar-title">Client Acquisition</span>
            </div>
            <div class="topbar-right">
                <span class="topbar-date">
                    <Icon Name="calendar" Class="toast-icon" />
                    @Format.WeekdayDate(DateTime.Now)
                </span>
                <div class="topbar-user">
                    <div class="who">
                        <strong>Admin</strong>
                        <span>Conectado</span>
                    </div>
                    <span class="avatar">AD</span>
                </div>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

<AppToast />

@code {
    private bool _open;

    private void ToggleMenu() => _open = !_open;
    private void CloseMenu() => _open = false;
}
